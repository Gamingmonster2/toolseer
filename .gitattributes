# Normalise line endings so the repository behaves the same on every machine.
# Without this, Git rewrites every text file on checkout and reports a warning on
# every commit; worse, a CRLF sneaking into `_redirects` or `_headers` is the kind
# of thing that is only noticed when a redirect silently stops matching.
* text=auto eol=lf

# Binaries must never be touched by the text filters.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.wasm binary
*.gz binary
*.traineddata binary
*.traineddata.gz binary

# Vendor bundles are generated by tools/vendor.mjs and are never diffed by hand.
apps/web/vendor/** -diff linguist-vendored
