# Cloudflare Pages headers. Applies to every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

# Immutable vendor assets carry content hashes in vendor.lock.json.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker, the manifest and the offline page must never be served from
# a stale HTTP cache: a cached worker keeps serving the old site to exactly the
# users we are trying not to lose. Specific rules must come BEFORE /assets/*.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/offline.html
  Cache-Control: public, max-age=3600

# Unhashed CSS and JS revalidate on every deploy. A long TTL here would keep the
# old toolkit.js alive long after the HTML that calls it changed.
/assets/css/*
  Cache-Control: no-cache

/assets/js/*
  Cache-Control: no-cache

/assets/img/*
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=86400
