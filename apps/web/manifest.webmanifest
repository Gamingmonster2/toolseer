{
  "id": "/",
  "name": "ToolSeer",
  "short_name": "ToolSeer",
  "description": "Merge, compress, split, protect and convert PDFs entirely in your browser. Free, fast, private — your files never leave your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0040ff",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/assets/img/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/pwa/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Image to PDF",
      "short_name": "Images",
      "description": "Turn photos and scans into one PDF.",
      "url": "/image-to-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Merge PDF",
      "short_name": "Merge",
      "description": "Combine several PDFs into one file.",
      "url": "/merge-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Compress PDF",
      "short_name": "Compress",
      "description": "Make a PDF small enough to email.",
      "url": "/compress-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Split PDF",
      "short_name": "Split",
      "description": "Break a PDF into separate files or page ranges.",
      "url": "/split-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Protect PDF",
      "short_name": "Protect",
      "description": "Add a password to a PDF.",
      "url": "/protect-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Unlock PDF",
      "short_name": "Unlock",
      "description": "Remove a password you already know.",
      "url": "/unlock-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "PDF to Images",
      "short_name": "To images",
      "description": "Export PDF pages as PNG or JPEG.",
      "url": "/pdf-to-images",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Organize PDF",
      "short_name": "Organize",
      "description": "Reorder, rotate and delete pages.",
      "url": "/organize-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Extract Text from PDF",
      "short_name": "Extract",
      "description": "Pull the words out of a PDF, with OCR for scans.",
      "url": "/extract-text-pdf",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Desktop app",
      "short_name": "Desktop",
      "description": "Offline Windows app for very large files.",
      "url": "/desktop",
      "icons": [
        { "src": "/assets/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    }
  ]
}
