<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The site paints its own chrome; the platform theme only needs to keep the
         window white so there is no flash of a dark background before the web view
         draws. -->
    <style name="Theme.ToolSeer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
