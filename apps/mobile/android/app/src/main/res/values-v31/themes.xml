<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows this the instant the icon is tapped, so the app never
         opens as a bare white rectangle. -->
    <style name="Theme.ToolSeer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
