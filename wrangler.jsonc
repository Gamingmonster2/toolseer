// Cloudflare deployment configuration.
//
// WHY THIS FILE EXISTS
// The project was created as a Worker with Git integration, so Cloudflare runs
// `npx wrangler deploy` — and that command has no idea this is a static site.
// Without a config it tries to guess a folder of HTML/CSS/JS and gives up with:
//
//   ✘ Could not detect a directory containing static files
//
// `assets.directory` below is the answer, and it is the same folder the classic
// Pages flow would use (docs/MIGRATION.md): the files in `apps/web` ARE the
// finished site, so there is no build step and nothing to compile.
//
// ⚠️ ONE LINE TO CHECK: `name` must equal your Worker's name in the Cloudflare
// dashboard. If yours differs, change it here — a mismatch deploys to a
// differently-named Worker and the URL you are watching stays empty.
{
  "name": "toolseer",
  "compatibility_date": "2026-10-07",
  "assets": {
    // The deployable site. No build command, no package.json, on purpose.
    "directory": "apps/web",
    // ⚠️ MUST BE `drop-trailing-slash`, NOT the default.
    //
    // The default (`auto-trailing-slash`) treats `/image-to-pdf/` as the canonical
    // form and redirects `/image-to-pdf` to it — while `_redirects` in this project
    // normalises the other way (`/image-to-pdf/` → `/image-to-pdf`). The two rules
    // bounce a request back and forth forever, and the browser gives up with an
    // empty page that looks like a dropped connection. That is exactly what the
    // first successful deploy did.
    //
    // `drop-trailing-slash` agrees with every canonical URL, sitemap entry and
    // JSON-LD block in the project: `/image-to-pdf` serves `image-to-pdf/index.html`
    // directly, and a trailing slash redirects to the form we already declare.
    "html_handling": "drop-trailing-slash",
    // Serve our own 404.html with a real 404 status instead of a blank page.
    "not_found_handling": "404-page"
  }
}
